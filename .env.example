# ========================================================
# College Notice Board Management System - Environment Config
# ========================================================

# Application Information
APP_NAME=College Notice Board Management System
COLLEGE_NAME=Shree Devi Institute of Technology

# Cryptographic Secret Key (Used for HMAC session tokens and security)
# In production, replace with a 64+ char random hex string (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=change-this-in-production-random-secret-key-sdit-2026

# Faculty Invitation & Approval Code
# Institutional joining code for verified faculty signups.
FACULTY_INVITE_CODE=SDIT-FACULTY-2026

# Database File Path (SQLite)
DATABASE_FILE=notice_board.db

# File Storage Configuration
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=5242880 # 5 MB

# Session & Cookie Security
SESSION_MAX_AGE_SECONDS=86400 # 24 Hours
COOKIE_SECURE=false # Set to true in production over HTTPS
